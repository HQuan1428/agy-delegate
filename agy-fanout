#!/usr/bin/env bash
# Run every <tasks-dir>/*.md through `agy -p` in parallel, each in its own git worktree
# on branch task/<name>. Logs go to <tasks-dir>/<name>.log. Re-running reuses existing worktrees.
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: agy-fanout <tasks-dir> [jobs]" >&2; exit 2; }
export DIR=$(realpath "$1") JOBS=${2:-${AGY_JOBS:-4}}
export ROOT=$(git rev-parse --show-toplevel) BASE=$(git rev-parse --abbrev-ref HEAD)
exclude=$(git rev-parse --git-path info/exclude)
grep -qxF '.worktrees/' "$exclude" 2>/dev/null || echo '.worktrees/' >> "$exclude"

run_one() {
  local f=$1 name wt
  name=$(basename "$f" .md); wt="$ROOT/.worktrees/$name"
  if [ ! -d "$wt" ]; then
    git -C "$ROOT" worktree add -q -b "task/$name" "$wt" "$BASE" 2>/dev/null \
      || git -C "$ROOT" worktree add -q "$wt" "task/$name"
  fi
  if (cd "$wt" && agy -p "$(cat "$f")" --dangerously-skip-permissions) > "$DIR/$name.log" 2>&1; then
    git -C "$wt" add -A
    git -C "$wt" diff --cached --quiet || git -C "$wt" commit -qm "task: $name"
    echo "OK    $name  ($(git -C "$ROOT" rev-list --count "$BASE..task/$name") commits)"
  else
    echo "FAIL  $name  (see $DIR/$name.log)"
  fi
}
export -f run_one

shopt -s nullglob; tasks=("$DIR"/*.md)
[ ${#tasks[@]} -gt 0 ] || { echo "no *.md in $DIR" >&2; exit 1; }
echo "running ${#tasks[@]} tasks, $JOBS at a time, base=$BASE"
printf '%s\0' "${tasks[@]}" | xargs -0 -P "$JOBS" -I{} bash -c 'run_one "$1"' _ {}
